/* Rofi configuration */
/* Standalone CachyOS Hyprland - Everforest (self-contained) */

configuration {
    modi: "drun,run,window,emoji,clipboard";
    show-icons: true;
    icon-theme: "Papirus";
    drun-display-format: "{icon} {name}";

    /* Layout */
    location: 0;
    fullscreen: false;
    width: 600;
    lines: 12;
    columns: 1;
    line-margin: 6;
    line-padding: 10;
    sidebar-mode: false;

    /* Behavior */
    disabled-layouts: "";
    kb-row-up: "Up,Control+p";
    kb-row-down: "Down,Control+n";
    kb-accept-entry: "Control+j,Control+m,Return,KP_Enter";
    kb-cancel: "Escape,Control+c,Control+g";

    /* Style */
    display-drun: "  Apps";
    display-window: "  Windows";
    display-run: "  Run";
    display-emoji: "  Emoji";
    display-clipboard: "  Clipboard";
}

window {
    location: center;
    anchor: center;

    /* Rounded corners */
    border-radius: 12px;
    border: 1px;

    /* Everforest colors */
    background-color: rgba(45, 53, 59, 0.95);
    border-color: rgba(127, 187, 179, 0.6);
    text-color: rgba(211, 198, 170, 1.0);

    width: 600px;
}

mainbox {
    margin: 12px 0px;
    padding: 12px;
}

listview {
    lines: 12;
    columns: 1;
    padding: 8px 0px;
    fixed-height: true;
}

element {
    padding: 10px 12px;
    border-radius: 8px;
    background-color: transparent;
    text-color: rgba(211, 198, 170, 1.0);
}

element selected {
    background-color: rgba(167, 192, 128, 0.2);
    text-color: rgba(167, 192, 128, 1.0);
}

element-icon {
    size: 24px;
    margin-right: 12px;
}

element-text {
    vertical-align: 0.5;
    horizontal-align: 0.0;
}

inputbar {
    margin: 0px 0px 8px;
    padding: 10px 14px;
    border-radius: 8px;
    background-color: rgba(52, 63, 68, 0.8);
    text-color: rgba(211, 198, 170, 1.0);
}

entry {
    text-color: rgba(211, 198, 170, 1.0);
}

prompt {
    margin-right: 8px;
    text-color: rgba(127, 187, 179, 1.0);
}

message {
    margin: 8px 0px;
    padding: 8px 12px;
    border-radius: 8px;
    background-color: rgba(52, 63, 68, 0.8);
}

scrollbar {
    width: 6px;
    padding: 0px 4px;
    handle-width: 6px;
}
